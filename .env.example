# Leave VITE_GAS_WEB_APP_URL empty (or delete .env entirely) to run `npm run dev`
# against the built-in mock backend in dev/mock-backend.js. Set it to a deployed
# Apps Script /exec URL to talk to a real Google Sheet -- including production,
# so point it at a separate test deployment when experimenting.
VITE_GAS_WEB_APP_URL=
VITE_ALLOWED_EMAIL_DOMAIN=ched.gov.ph
